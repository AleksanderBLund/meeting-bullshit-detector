{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist/client",
    "rootDir": "./client/src",
    "resolveJsonModule": true
  },
  "include": ["client/src/**/*", "shared/**/*"]
}
